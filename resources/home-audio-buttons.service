# systemd unit for buttons.py
#
# Logs:   journalctl -u home-audio-buttons -f

[Unit]
Description=Home Audio Buttons
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
# Needed to read /dev/input/event* via evdev
SupplementaryGroups=input
WorkingDirectory=/home/pi/home-audio-buttons
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/pi/home-audio-buttons/.env
ExecStart=/home/pi/home-audio-buttons/.venv/bin/python buttons.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
